api_connect_timeout=30
api_receiver_timeout=30
api_send_timeout=30
api_content_type=application/json

# OpenAI — thường cần nạp tiền; free credit hay hết (lỗi 429)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq — FREE, khuyên dùng: https://console.groq.com/keys
GROQ_API_KEY=
